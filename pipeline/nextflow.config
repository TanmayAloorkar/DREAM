params {
    samplesheet = null
    outdir      = 'results'
}

conda {
    enabled  = true
    useMamba = true
    cacheDir = "${System.getenv('HOME')}/.nextflow/conda-cache"
}

process {
    cpus   = 2
    memory = '2 GB'
}

executor {
    cpus   = 22
    memory = '13 GB'
}

profiles {
    test {
        params.samplesheet = "${projectDir}/../tests/samplesheet.csv"
        params.outdir      = "${projectDir}/../results/test"
    }
}
