params {
    samplesheet  = null
    outdir       = 'results'
    gtf          = null
    hisat2_index = null
    fasta        = null    // only used to build an index when hisat2_index is not set
    strandedness = 'reverse'
}

conda {
    enabled  = true
    useMamba = true
    cacheDir = "${System.getenv('HOME')}/.nextflow/conda-cache"
}

process {
    cpus   = 2
    memory = '2 GB'
    resourceLimits = [cpus: 22, memory: 13.GB]
}

// 13 GB total keeps HISAT2 to one job at a time on a 15 GB machine
executor {
    cpus   = 22
    memory = '13 GB'
}

profiles {
    test {
        params.samplesheet = "${projectDir}/../tests/samplesheet.csv"
        params.fasta       = "${projectDir}/../tests/data/genome.fa"
        params.gtf         = "${projectDir}/../tests/data/genes.gtf"
        params.outdir      = "${projectDir}/../results/test"
        process.resourceLimits = [cpus: 4, memory: 6.GB]
        executor.cpus   = 4
        executor.memory = '6 GB'
    }
}
